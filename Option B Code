def get_ms1_cache(fname):

    if fname not in ms1_cache_by_file:

        if fname not in MZML_FILE_MAP:
            return None

        print(
            "Reading MS1:",
            fname
        )

        ms1_cache_by_file[fname] = (
            build_ms1_cache(
                MZML_FILE_MAP[fname]
            )
        )

        print(
            "  MS1 scans:",
            len(
                ms1_cache_by_file[
                    fname
                ]
            )
        )

    return ms1_cache_by_file[
        fname
    ]


