            best_sample[
                "ms1_isotope_positive_raw"
            ],

        "ms1_isotope_score":
            best_sample[
                "ms1_isotope_score"
            ],

        "ms1_background_subtracted":
            background_subtracted,

        "ms1_final_keep":
            final_keep,

        "best_sample_file":
            best_sample[
                "file"
            ],

        "sample_files_used":
