def build_ms1_cache(mzml_path):

    cache = []

    with mzml.MzML(mzml_path) as reader:

        for spec in reader:

            if spec.get("ms level") == 1:

                scan = spec["scanList"]["scan"][0]

                rt = scan.get(
                    "scan start time",
                    np.nan
                )

                unit = scan.get(
                    "scan start time unit",
                    ""
                ).lower()

                if "second" in unit:
                    rt_seconds = float(rt)

                else:
                    rt_seconds = float(rt) * 60.0

                mz_array = np.asarray(
                    spec["m/z array"],
                    dtype=float
                )

                int_array = np.asarray(
                    spec["intensity array"],
                    dtype=float
                )

                cache.append(
                    (
                        rt_seconds,
                        mz_array,
                        int_array
                    )
                )

    return cache


def integrate_peak(
    mz_array,
    int_array,
    target_mz,
    tol=MZ_TOL
):

    mask = (
        (mz_array >= target_mz - tol)
        &
        (mz_array <= target_mz + tol)
    )

    if np.any(mask):
        return float(
            np.sum(int_array[mask])
        )

    return 0.0


def integrate_peak_rt_window(
    ms1_cache,
    rt_seconds,
    target_mz
):

    vals = []

    for scan_rt, mz_array, int_array in ms1_cache:

        if abs(scan_rt - rt_seconds) <= RT_WINDOW_SECONDS:

            vals.append(
                integrate_peak(
                    mz_array,
                    int_array,
                    target_mz
                )
            )

    if len(vals) == 0:
        return 0.0, 0

    return (
        float(np.mean(vals)),
        len(vals)
    )


def calculate_ms1_chlorine_isotope(
    ms1_cache,
    rt_seconds,
    precursor_mz
):

    # -----------------------------
    # Integrate M
    # -----------------------------

    M_int, n_scans = integrate_peak_rt_window(
        ms1_cache,
        rt_seconds,
        precursor_mz
    )

    # -----------------------------
    # Integrate M+2
    # -----------------------------

    M2_int, _ = integrate_peak_rt_window(
        ms1_cache,
        rt_seconds,
        precursor_mz + CL_M2_SHIFT
    )

    # -----------------------------
    # Integrate M+4
    # -----------------------------

    M4_int, _ = integrate_peak_rt_window(
        ms1_cache,
        rt_seconds,
        precursor_mz + CL_M4_SHIFT
    )

    # -----------------------------
    # Minimum M intensity check
    # -----------------------------

    if M_int < MIN_M_INTENSITY:

        return {
            "ms1_isotope_positive_raw": 0,
            "ms1_isotope_score": 0.0,
            "best_matching_n_chlorines": 0,
            "M_intensity": M_int,
            "M_plus_2_intensity": M2_int,
            "M_plus_4_intensity": M4_int,
            "M_plus_2_over_M_ratio": 0.0,
            "M_plus_4_over_M_ratio": 0.0,
            "M2_ratio_error": np.nan,
            "M4_ratio_error": np.nan,
            "n_ms1_scans_used": n_scans,
            "low_M_intensity_flag": 1
        }

    # -----------------------------
    # Calculate isotope ratios
    # -----------------------------

    M2_ratio = M2_int / (
        M_int + EPS
    )

    M4_ratio = M4_int / (
        M_int + EPS
    )

    best_n = 0
    best_M2_error = np.inf
    best_M4_error = np.inf
    best_total_error = np.inf

    # -----------------------------
    # Compare with expected
    # chlorine isotope patterns
    # -----------------------------

    for n_cl in EXPECTED_M2:

        M2_error = abs(
            M2_ratio
            - EXPECTED_M2[n_cl]
        )

        M4_error = abs(
            M4_ratio
            - EXPECTED_M4[n_cl]
        )

        if n_cl == 1:

            total_error = M2_error

        else:

            total_error = (
                M2_error
                + 0.5 * M4_error
            )

        if total_error < best_total_error:

            best_total_error = total_error
            best_n = n_cl
            best_M2_error = M2_error
            best_M4_error = M4_error

    # -----------------------------
    # Convert M+2 agreement into
    # continuous isotope score
    # -----------------------------

    score = max(
        0.0,
        1.0 - (
            best_M2_error
            / RATIO_TOL
        )
    )

    positive = int(
        best_M2_error <= RATIO_TOL
    )

    # Require M+4 agreement
    # when ≥2 chlorine atoms expected
    if (
        best_n >= 2
        and
        best_M4_error > M4_TOL
    ):

        positive = 0

        score = min(
            score,
            0.49
        )

    return {

        "ms1_isotope_positive_raw":
            positive,

        "ms1_isotope_score":
            score,

        "best_matching_n_chlorines":
            best_n,

        "M_intensity":
            M_int,

        "M_plus_2_intensity":
            M2_int,

        "M_plus_4_intensity":
            M4_int,

        "M_plus_2_over_M_ratio":
            M2_ratio,

        "M_plus_4_over_M_ratio":
            M4_ratio,

        "M2_ratio_error":
            best_M2_error,

        "M4_ratio_error":
            best_M4_error,

        "n_ms1_scans_used":
            n_scans,

        "low_M_intensity_flag":
            0
    }


