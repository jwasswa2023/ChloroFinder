    files_in_feature = (
        row["_file_list"]
    )

    sample_files = [

        f
        for f in files_in_feature

        if (
            is_sample_file(f)
            and
            f in MZML_FILE_MAP
        )

    ]

    # -----------------------------
    # No sample file
    # -----------------------------

    if len(sample_files) == 0:

        results.append({

            "ms1_isotope_positive_raw": 0,
            "ms1_isotope_score": 0.0,
            "ms1_background_subtracted": 0,
            "ms1_final_keep": 0,

            "best_sample_file": "",
            "sample_files_used": "",
            "background_files_used":
