def safe_parse_list(x):

    if isinstance(x, list):
        return [float(v) for v in x]

    if pd.isna(x):
        return []

    s = str(x).strip()

    try:
        val = ast.literal_eval(s)

        if isinstance(val, (list, tuple, np.ndarray)):
            return [float(v) for v in val]

    except Exception:
        pass

    for sep in [";", "|", ":"]:
        s = s.replace(sep, ",")

    try:
        return [
            float(v.strip())
            for v in s.strip("[]()").split(",")
            if v.strip()
        ]

    except Exception:
        return []


def round_unique(values, dp):

    out = []
    seen = set()

    for v in values:

        try:
            rv = round(float(v), dp)

            if rv > 0 and rv not in seen:
                seen.add(rv)
                out.append(rv)

        except Exception:
            continue

    return sorted(out)


def compute_delta_mz_list(
    frag_list,
    round_dp=3,
    min_delta=0.001
):

    if len(frag_list) < 2:
        return []

    frags = sorted(
        set(float(f) for f in frag_list)
    )

    deltas = []

    for a, b in combinations(frags, 2):

        d = abs(b - a)

        if d >= min_delta:
            deltas.append(
                round(d, round_dp)
            )

    return sorted(set(deltas))


def split_filenames(x):

    if pd.isna(x):
        return []

    return [
        os.path.basename(v.strip())
        for v in str(x).split(";")
        if v.strip()
    ]


def is_sample_file(fname):

    return any(
        fname.startswith(prefix)
        for prefix in SAMPLE_PREFIXES
    )


