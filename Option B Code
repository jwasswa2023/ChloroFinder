        )
    ],

    axis=1
)


# ============================================================
# MERGE RULE4 SCORE
#
# IMPORTANT:
# Rule4 is retained as independent supporting MS2 evidence.
# It does NOT contribute to CombinedScore.
# ============================================================

r4 = pd.read_csv(
    RULE4_ALL_FILE
)

r4["FeatureID"] = (
    make_feature_id(
        r4
    )
)


rule4_score_col = (
    find_score_col(

        r4,

        [

            "rule4_cl_fragment_pair_score",
            "Rule4_score",
            "rule4_score"

        ]
    )
)


r4_score = (

    r4[
        [
            "FeatureID",
            rule4_score_col
        ]
    ]

    .drop_duplicates(
        "FeatureID"
    )

    .copy()
)


r4_score.columns = [

    "FeatureID",
    "rule4_cl_fragment_pair_score"

]


out = out.merge(

    r4_score,

    on="FeatureID",

    how="left"

)


out[
    "rule4_cl_fragment_pair_score"
] = (

    out[
        "rule4_cl_fragment_pair_score"
    ]

    .fillna(0.0)

    .astype(float)
)


# ============================================================
# OPTION B COMBINED SCORE
#
# NEW FORMULA:
#
# CombinedScore =
#     0.60 × ChloroFinder probability
#   + 0.40 × MS1 isotope score
#
# Rule4 is NOT included.
# ============================================================

out["CombinedScore"] = (

    0.60
    * out[
        "ChloroFinder_probability"
    ]

    +

    0.40
    * out[
        "ms1_isotope_score"
    ]

)


out["CombinedScore_positive"] = (

    out[
        "CombinedScore"
    ]

    >= COMBINED_SCORE_THRESHOLD

).astype(int)


# ============================================================
# INDEPENDENT EVIDENCE SCORE
#
# Rule4 remains here because this variable counts
# independent evidence streams rather than contributing
# to the weighted CombinedScore.
# ============================================================

out["OptionB_EvidenceScore"] = (

    out[
        "ms1_final_keep"
    ]

    +

    out[
        "ChloroFinder_default"
    ]

    +

    (
        out[
            "rule4_cl_fragment_pair_score"
        ]
        > 0
    ).astype(int)

)


# ============================================================
# PRIORITIZATION TIERS
# ============================================================

out["OptionB_Tier"] = (
    "Tier 5: Low priority"
)


# -----------------------------
# Tier 1
# Combined score positive
# AND MS1 positive
# AND ChloroFinder >= 0.50
# -----------------------------

out.loc[

    (
        out[
            "CombinedScore_positive"
        ]
        == 1
    )

    &

    (
        out[
            "ms1_final_keep"
        ]
        == 1
    )

    &

    (
        out[
            "ChloroFinder_default"
        ]
        == 1
    ),

    "OptionB_Tier"

] = (
    "Tier 1: High confidence "
    "CombinedScore + MS1 + ML"
)


# -----------------------------
# Tier 2
# CombinedScore positive
# -----------------------------

out.loc[

    (
        out[
            "OptionB_Tier"
        ]
        == "Tier 5: Low priority"
    )

    &

    (
        out[
            "CombinedScore_positive"
        ]
        == 1
    ),

    "OptionB_Tier"

] = (
    "Tier 2: CombinedScore positive"
)


# -----------------------------
# Tier 3
# MS1 + ML agreement
# -----------------------------

out.loc[

    (
        out[
            "OptionB_Tier"
        ]
        == "Tier 5: Low priority"
    )

    &

    (
        out[
            "ms1_final_keep"
        ]
        == 1
    )

    &

    (
        out[
            "ChloroFinder_default"
        ]
        == 1
    ),

    "OptionB_Tier"

] = (
    "Tier 3: MS1 + ML agreement"
)


# -----------------------------
# Tier 4
# One strong evidence stream
# -----------------------------

out.loc[

    (
        out[
            "OptionB_Tier"
        ]
        == "Tier 5: Low priority"
    )

    &

    (

        (
            out[
                "ChloroFinder_high"
            ]
            == 1
        )

        |

        (
            out[
                "ms1_final_keep"
            ]
            == 1
        )

    ),

    "OptionB_Tier"

] = (
    "Tier 4: Single strong evidence"
)


out["OptionB_Prioritized"] = (

    out[
        "OptionB_Tier"
    ]

    != "Tier 5: Low priority"

).astype(int)


# ============================================================
# OPTIONAL RULE4 SUPPORT FLAGS
#
# These do NOT affect CombinedScore.
# They simply indicate whether Rule4 independently
# supports a candidate.
# ============================================================

out["Rule4_support"] = (

    out[
        "rule4_cl_fragment_pair_score"
    ]
    > 0

).astype(int)


out["CombinedScore_with_Rule4_support"] = (

