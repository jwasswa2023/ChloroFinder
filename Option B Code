            sample_minus_bg,

        "sample_to_background_ratio":
            sample_bg_ratio,

        "best_matching_n_chlorines":
            best_sample[
                "best_matching_n_chlorines"
            ],

        "M_plus_2_intensity":
            best_sample[
                "M_plus_2_intensity"
            ],

        "M_plus_4_intensity":
            best_sample[
                "M_plus_4_intensity"
            ],

        "M_plus_2_over_M_ratio":
            best_sample[
                "M_plus_2_over_M_ratio"
            ],

        "M_plus_4_over_M_ratio":
            best_sample[
                "M_plus_4_over_M_ratio"
            ],

        "M2_ratio_error":
            best_sample[
