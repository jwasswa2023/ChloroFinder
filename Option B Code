            "sample_M_intensity": np.nan,
            "background_M_intensity_max": np.nan,
            "sample_minus_background": np.nan,
            "sample_to_background_ratio": np.nan,

            "best_matching_n_chlorines": 0,

            "M_plus_2_intensity": np.nan,
            "M_plus_4_intensity": np.nan,

            "M_plus_2_over_M_ratio": np.nan,
            "M_plus_4_over_M_ratio": np.nan,

            "M2_ratio_error": np.nan,
            "M4_ratio_error": np.nan,

            "n_ms1_scans_used": 0,
            "low_M_intensity_flag": 1,

            "ms1_status":
                "no_sample_file"

        })

        continue


    # -----------------------------
    # Process each sample file
    # -----------------------------

    sample_results = []

    for fname in sample_files:

        cache = get_ms1_cache(
            fname
        )

        if cache is None:
            continue

        r = calculate_ms1_chlorine_isotope(

            ms1_cache=cache,
            rt_seconds=rt_seconds,
            precursor_mz=precursor_mz

        )

        r["file"] = fname

        sample_results.append(
            r
        )


    # -----------------------------
    # No usable MS1 cache
    # -----------------------------

    if len(sample_results) == 0:

        results.append({

            "ms1_isotope_positive_raw": 0,
            "ms1_isotope_score": 0.0,
            "ms1_background_subtracted": 0,
            "ms1_final_keep": 0,

            "best_sample_file": "",
            "sample_files_used":
                ";".join(
                    sample_files
                ),

            "background_files_used":
                ";".join(
                    BACKGROUND_FILES
                ),

            "sample_M_intensity": np.nan,
            "background_M_intensity_max": np.nan,
            "sample_minus_background": np.nan,
            "sample_to_background_ratio": np.nan,

            "best_matching_n_chlorines": 0,

            "M_plus_2_intensity": np.nan,
            "M_plus_4_intensity": np.nan,

            "M_plus_2_over_M_ratio": np.nan,
            "M_plus_4_over_M_ratio": np.nan,

            "M2_ratio_error": np.nan,
            "M4_ratio_error": np.nan,

            "n_ms1_scans_used": 0,
            "low_M_intensity_flag": 1,

            "ms1_status":
                "missing_sample_cache"

        })

        continue


    # -----------------------------
    # Select best MS1 isotope match
    # -----------------------------

    best_sample = max(

        sample_results,

        key=lambda x:
        x["ms1_isotope_score"]

    )


    # -----------------------------
    # Background intensities
    # -----------------------------

    background_M_values = []

    for bg_file in BACKGROUND_FILES:

        bg_cache = get_ms1_cache(
            bg_file
        )

        if bg_cache is None:
            continue

        bg_M, _ = (
            integrate_peak_rt_window(

                bg_cache,
                rt_seconds,
                precursor_mz

            )
        )

        background_M_values.append(
            bg_M
        )


    if background_M_values:

        bg_max = float(
            np.max(
                background_M_values
            )
        )

    else:

        bg_max = 0.0


    sample_M = (
        best_sample[
            "M_intensity"
        ]
    )

    sample_minus_bg = (
        sample_M
        - bg_max
    )

    sample_bg_ratio = (
        sample_M
        /
        (
            bg_max
            + EPS
        )
    )


    # -----------------------------
    # Background-subtraction test
    # -----------------------------

    background_subtracted = int(

        (
            sample_M
            >= MIN_M_INTENSITY
        )

        and

        (
            sample_minus_bg
            >= MIN_SAMPLE_MINUS_BACKGROUND
        )

        and

        (
            sample_bg_ratio
            >= BACKGROUND_FOLD_CHANGE
        )

    )


    # -----------------------------
    # Final MS1 keep
    # -----------------------------

    final_keep = int(

        (
            best_sample[
                "ms1_isotope_positive_raw"
            ]
            == 1
        )

        and

        (
            background_subtracted
            == 1
        )

    )


    results.append({

